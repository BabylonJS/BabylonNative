  <!-- Build after C++/WinRT has generated the version-matched projections used by this project. -->
  <Target Name="BabylonNativeBuild"
          AfterTargets="CppWinRTMakeProjections"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <CppWinRTProjectionDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(GeneratedFilesDir)'))</CppWinRTProjectionDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(CppWinRTProjectionDir)\winrt\base.h')"
           Text="C++/WinRT projections were not generated at '$(CppWinRTProjectionDir)'. Babylon Native cannot be built with a different projection version." />
    <Exec Command='cmake -G"$(BabylonNativeCMakeGenerator)" -B"$(BabylonNativeBuildDir)." -DCMAKE_SYSTEM_NAME=WindowsStore -DCMAKE_SYSTEM_VERSION=$(WindowsTargetPlatformVersion) -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY -A$(Platform) -T$(PlatformToolset) -DJSRUNTIMEHOST_CORE_APPRUNTIME=0 -DCPPWINRT_INCLUDE_PATH="$(CppWinRTProjectionDir)." -S"$(ProjectDir).."' />
    <Exec Command='cmake --build "$(BabylonNativeBuildDir)." --config "$(Configuration)" --target BabylonNative --parallel' />
  </Target>
  <Target Name="EnsureReactNativeWindowsTargets" BeforeTargets="PrepareForBuild">
