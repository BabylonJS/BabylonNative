<?xml version="1.0" encoding="utf-8"?>
<!-- The XMLHttpRequest and fetch tests request plain http:// URLs from a server that the test
     process runs on 127.0.0.1. Cleartext stays blocked for every other host. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
