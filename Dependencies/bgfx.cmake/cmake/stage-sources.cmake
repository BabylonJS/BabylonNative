function(bgfx_stage_sources wrapper destination)
	file(REAL_PATH "${wrapper}" wrapper)
	file(REAL_PATH "${destination}" destination)
	set(wrapper_compare "${wrapper}")
	set(destination_compare "${destination}")
	if(WIN32)
		string(TOLOWER "${wrapper_compare}" wrapper_compare)
		string(TOLOWER "${destination_compare}" destination_compare)
	endif()
	if(NOT wrapper_compare STREQUAL destination_compare)
		file(MAKE_DIRECTORY "${destination}")
		# Remove the obsolete harness from incremental source-tree packages.
		file(REMOVE_RECURSE "${destination}/tests")
		if(EXISTS "${destination}/tests")
			message(FATAL_ERROR "Cannot remove the stale staged wrapper tests directory: ${destination}/tests")
		endif()
		file(GLOB wrapper_files LIST_DIRECTORIES false "${wrapper}/*" "${wrapper}/.*")
		list(FILTER wrapper_files EXCLUDE REGEX "/\\.git$")
		file(COPY ${wrapper_files} DESTINATION "${destination}")
		foreach(directory cmake .github)
			if(IS_DIRECTORY "${wrapper}/${directory}")
				file(COPY "${wrapper}/${directory}" DESTINATION "${destination}" PATTERN ".git" EXCLUDE)
			endif()
		endforeach()
	endif()

	foreach(name bgfx bx bimg)
		string(TOUPPER "${name}" upper)
		file(REAL_PATH "${${upper}_DIR}" selected)
		file(REAL_PATH "${destination}/${name}" target)
		set(selected_compare "${selected}")
		set(target_compare "${target}")
		if(WIN32)
			string(TOLOWER "${selected_compare}" selected_compare)
			string(TOLOWER "${target_compare}" target_compare)
		endif()
		if(NOT selected_compare STREQUAL target_compare)
			cmake_path(IS_PREFIX selected_compare "${target_compare}" NORMALIZE target_inside_source)
			cmake_path(IS_PREFIX target_compare "${selected_compare}" NORMALIZE source_inside_target)
			if(target_inside_source OR source_inside_target)
				message(FATAL_ERROR "Cannot stage overlapping ${name} source and package directories: ${selected}, ${target}")
			endif()
			file(REMOVE_RECURSE "${target}")
			if(EXISTS "${target}")
				message(FATAL_ERROR "Cannot refresh the staged ${name} source directory: ${target}")
			endif()
			file(COPY "${selected}/" DESTINATION "${target}" PATTERN ".git" EXCLUDE)
		endif()
	endforeach()

	# Snapshot the selected source version, never rewrite its src/version.h.
	include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/version.cmake")
	file(WRITE "${destination}/bgfx/.bgfx-cmake-version"
		"api=${BGFX_API_VERSION}\nrevision=${BGFX_REV_NUMBER}\nsha=${BGFX_REV}\n")
endfunction()
